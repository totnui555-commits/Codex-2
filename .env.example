POSTGRES_PASSWORD=
# Generate secrets locally or provision through the deployment secret manager.
DATABASE_URL=postgresql+psycopg://company:replace-with-private-password@localhost:5432/company
SESSION_SECRET=
BOOTSTRAP_TOKEN=
APP_ORIGIN=http://localhost:3000
# false ONLY on a private HTTP development installation; true behind production HTTPS.
SECURE_COOKIES=true
FOUNDER_EMAIL=traisorn.th@gmail.com
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
MODEL_PROVIDER=openai
OPENROUTER_API_KEY=
OPENAI_API_KEY=
RESEARCH_MODEL=gpt-4.1-mini
CODEX_PROVIDER=openai
CODEX_MODEL=gpt-5-codex
CODEX_INPUT_USD_PER_MILLION=0
CODEX_OUTPUT_USD_PER_MILLION=0
# Do not use example prices. Set current provider prices and dated FX, then opt in as owner.
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
THB_PER_USD=0
FX_OBSERVED_AT=
SANDBOX_THB_PER_MINUTE=0
SANDBOX_PRICE_OBSERVED_AT=
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_SNAPSHOT=
MODEL_GATEWAY_PUBLIC_URL=
# Install a least-privilege GitHub App; inject a short-lived installation token here.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
ARTIFACT_BACKEND=s3
ARTIFACT_DIRECTORY=.local/artifacts
ARTIFACT_ENCRYPTION_KEY=
ARTIFACT_ACCESS_KEY_ID=
ARTIFACT_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT_URL=
# boto3 uses its supported ambient identity/secret manager credentials.
# Gmail OAuth scope: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
EMAIL_SEND_AUTHORIZED=false
STRIPE_WEBHOOK_SECRET=
TELEMETRY_ENABLED=false
WORKER_POLL_SECONDS=15
RUNTIME=development

# Temporal Cloud transport (keep API keys in deployment secret storage)
TEMPORAL_TLS=false
TEMPORAL_API_KEY=

@@ -1287,3 +1287,24 @@
 .kingdom-mode:has(.island-focus) .main > .info-strip:has(+ .stop-banner) {
   top: 122px;
 }
+
+/* Software WebGL already consumes CPU for the world. Avoid repeatedly blurring
+   that moving canvas beneath every floating panel; retain the glass tier on GPUs. */
+.kingdom-mode:has(.kingdom-edition[data-renderer="software"]) * {
+  backdrop-filter: none !important;
+  -webkit-backdrop-filter: none !important;
+}
+.kingdom-mode:has(.kingdom-edition[data-renderer="software"])
+  :is(
+    .sidebar,
+    .kingdom-inspector,
+    .kingdom-toolbar,
+    .kingdom-search,
+    .kingdom-search-results,
+    .kingdom-map-label,
+    .kingdom-controls,
+    .kingdom-destinations,
+    .kingdom-hud > div
+  ) {
+  background: #f5f9ff;
+}
